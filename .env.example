# ==============================================================================
# Environment Variables Example for Grandma Chen Care Coordinator (.env)
# Copy this file to .env and fill in your actual credential values.
# ==============================================================================

# AWS Access Key ID for authenticating boto3 requests to AWS SageMaker
# Get this from AWS IAM Console -> Users -> Security Credentials
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key corresponding to your AWS Access Key ID
# Get this from AWS IAM Console when generating your Access Key
AWS_SECRET_ACCESS_KEY=

# AWS Region where your AWS SageMaker endpoint is deployed (e.g. ap-south-1)
AWS_REGION=ap-south-1

# Connection string for your CockroachDB Cloud Serverless database
# Get this from CockroachDB Cloud Dashboard under "Connect" -> Connection String
COCKROACH_CLOUD_URL=

# Connection string for optional local Docker CockroachDB cluster (for offline development)
# Default for local Docker container is postgresql://root@localhost:26257/agent_memory?sslmode=disable
COCKROACH_URL=postgresql://root@localhost:26257/agent_memory?sslmode=disable

# Selects which database mode to use: "cloud" (CockroachDB Cloud), "cloud-mcp" (via Cloud MCP), or "local" (Docker)
DB_MODE=cloud

# Selects vector embedding engine: "sagemaker" (AWS SageMaker endpoint) or "local" (local Python model)
EMBEDDING_MODE=sagemaker

# AWS IAM Role ARN required only when executing endpoint deployment scripts
# Get this from AWS IAM Console -> Roles
SAGEMAKER_ROLE_ARN=arn:aws:iam::631059080060:role/sagemaker-hackathon-execution-role

# Name of your deployed AWS SageMaker embedding endpoint
SAGEMAKER_ENDPOINT_NAME=caregiver-bge-embeddings

# Service Account API Key for authenticating HTTP requests to CockroachDB Cloud MCP Server
# Get this from CockroachDB Cloud Dashboard under Service Accounts -> API Keys
COCKROACHDB_MCP_API_KEY=

# Anthropic API Key used by the Care Coordinator agent to generate natural language answers
# Get this from Anthropic Console (https://console.anthropic.com/) -> API Keys
ANTHROPIC_API_KEY=

# Anthropic Claude model name used for AI response generation
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
